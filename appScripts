// ================== SETTINGS ==================
var BUSINESS_NAME  = "Absolute Car Cleaning";
var OWNER_EMAIL    = "joe1999.show@gmail.com";   // where you receive booking notifications
var SLOT_MINUTES   = 90;
var TIME_ZONE      = "Europe/Brussels";        // also set this in Project Settings
// ==============================================

// Runs on form submit (trigger: From form -> On form submit)
function onFormSubmit(e) {
  var r = e.response.getItemResponses();
  processBooking({
    name:     r[0].getResponse(),
    email:    r[1].getResponse(),
    phone:    r[2].getResponse(),
    dateTime: r[3].getResponse(),   // "YYYY-MM-DD HH:MM"
    options:  r[4].getResponse(),
    total:    r[5].getResponse()
  });
}

// Run this ONCE manually from the editor to test the emails.
// It creates a real calendar event, so delete it afterwards.
function testBooking() {
  processBooking({
    name: "Test Klant",
    email: "joe1999.show@gmail.com",
    phone: "0470 00 00 00",
    dateTime: "2026-12-01 14:00",
